PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/healthcare_system?retryWrites=true&w=majority
MONGODB_DB_NAME=healthcare_system
NODE_ENV=development
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN_MINUTES=15
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
AUTH_EXPOSE_RESET_SECRETS=false
SMTP_ENABLED=false
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM_NAME=MedCare Portal
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_REPLY_TO=support@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_me_now
SUPER_ADMIN_FULL_NAME=System Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
