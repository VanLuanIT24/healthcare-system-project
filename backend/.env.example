BANK_QR_INTENT_TTL_MINUTES=30
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/auth/success
FRONTEND_AUTH_FAILURE_URL=http://localhost:5173/auth/failure
MANUAL_PAYMENT_ENABLED=true
PAYMENT_RECEIPT_UPLOAD_ENABLED=true
